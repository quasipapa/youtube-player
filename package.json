{
	"name": "yt-playlist-player",
	"version": "0.1.0",
	"description": "A privacy-aware Gutenberg block for navigating a YouTube playlist.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20",
		"npm": ">=10.2.3"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src assets/js",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"format": "wp-scripts format && wp-scripts lint-style \"src/**/*.scss\" --fix",
		"format:check": "wp-scripts format --check",
		"composer:install": "sh scripts/composer.sh install",
		"composer:update": "sh scripts/composer.sh update",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:reset": "wp-env reset",
		"env:destroy": "wp-env destroy",
		"env:status": "wp-env status",
		"env:logs": "wp-env logs --no-watch",
		"env:test:start": "wp-env start --config=.wp-env.test.json",
		"env:test:stop": "wp-env stop --config=.wp-env.test.json",
		"format:php": "sh scripts/composer.sh run format",
		"lint:php": "sh scripts/composer.sh run lint",
		"test:php": "sh scripts/composer.sh run test",
		"test:js": "wp-scripts test-unit-js --runInBand",
		"check": "npm run format:check && npm run lint:js && npm run lint:css && npm run lint:php && npm run test:php && npm run test:js && npm run build",
		"test:responsive": "npm run build && playwright test"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@testing-library/react": "16.3.3",
		"@wordpress/block-editor": "17.0.0",
		"@wordpress/blocks": "15.27.0",
		"@wordpress/components": "40.0.0",
		"@wordpress/element": "8.6.0",
		"@wordpress/env": "11.14.0",
		"@wordpress/i18n": "6.27.0",
		"@wordpress/scripts": "34.2.0"
	},
	"overrides": {
		"qs": "6.16.0"
	}
}
