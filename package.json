{
	"name": "yt-playlist-player",
	"version": "0.1.0",
	"description": "A privacy-aware Gutenberg block for navigating a YouTube playlist.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.22.2",
		"npm": ">=10.2.3"
	},
	"scripts": {
		"build": "wp-scripts build",
		"check:docs": "node scripts/check-docs.mjs",
		"check:versions": "node scripts/check-delivery.mjs",
		"check:package": "node scripts/check-delivery.mjs dist/yt-playlist-player.zip",
		"test:ci": "node --test scripts/*.test.mjs",
		"plugin:zip": "sh scripts/build-zip.sh",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src assets/js",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"format": "wp-scripts format && wp-scripts lint-style \"src/**/*.scss\" --fix",
		"format:check": "prettier --config node_modules/@wordpress/prettier-config/lib/index.js --check '**/*.{cjs,js,json,mjs,yml,yaml}'",
		"composer:install": "sh scripts/composer.sh install",
		"composer:update": "sh scripts/composer.sh update",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:reset": "wp-env reset",
		"env:destroy": "wp-env destroy",
		"env:status": "wp-env status",
		"env:logs": "wp-env logs --no-watch",
		"env:test:start": "wp-env start --config=.wp-env.test.json",
		"env:test:stop": "wp-env stop --config=.wp-env.test.json",
		"format:php": "sh scripts/composer.sh run format",
		"lint:php": "sh scripts/composer.sh run lint",
		"test:php": "sh scripts/composer.sh run test",
		"test:js": "wp-scripts test-unit-js --project jsdom",
		"test:js:browser": "wp-scripts test-unit-js --project browser",
		"test:plugin-check": "sh scripts/plugin-check.sh",
		"i18n:generate": "sh scripts/i18n.sh generate",
		"i18n:check": "sh scripts/i18n.sh check",
		"check": "npm run check:docs && npm run test:ci && npm run format:check && npm run lint:js && npm run lint:css && npm run lint:php && npm run test:php && npm run test:js && npm run i18n:check && npm run build",
		"test:browser": "npm run build && playwright test",
		"test:local": "sh scripts/local-tests.sh",
		"test:responsive": "npm run build && playwright test tests/responsive",
		"test:accessibility": "npm run build && playwright test tests/accessibility"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.63.0",
		"@testing-library/react": "16.3.3",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/eslint-plugin": "^1.6.28",
		"@wordpress/block-editor": "20.0.0",
		"@wordpress/blocks": "17.1.0",
		"@wordpress/components": "44.0.0",
		"@wordpress/element": "10.1.0",
		"@wordpress/env": "12.1.0",
		"@wordpress/eslint-plugin": "28.1.0",
		"@wordpress/i18n": "7.1.0",
		"@wordpress/scripts": "37.1.0",
		"github-slugger": "2.0.0",
		"markdown-it": "14.3.3",
		"markdownlint": "0.41.1",
		"markdownlint-cli": "0.49.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"adm-zip": "0.6.1",
		"linkify-it": "5.0.2",
		"markdown-it": "14.3.3",
		"markdownlint-cli": {
			"minimatch": "3.1.5"
		},
		"qs": "6.16.0",
		"serialize-javascript": "7.0.5",
		"sockjs": {
			"uuid": "11.1.1"
		}
	}
}
